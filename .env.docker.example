# Synchro production environment for docker compose (ADR 0012).
# Copy to `.env` next to compose.yaml and fill in every secret.

APP_NAME=Synchro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://synchro.example.com
APP_PORT=80

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stderr
LOG_LEVEL=info

# MySQL 8.0 (the `mysql` service)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=synchro
DB_USERNAME=synchro
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Redis (the `redis` service): queues (Horizon), cache, and sessions
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-as-well
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=700
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Horizon emails this address when a queue waits too long (optional)
HORIZON_NOTIFY_EMAIL=

# Outgoing mail (invitation emails are sent by Horizon workers)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@isga.ma"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
