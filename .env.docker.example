# Synchro production environment for docker compose (ADR 0012).
# Copy to `.env` next to docker-compose.yml and fill in every secret.
# See the header of docker-compose.yml for every option.

# Bundled services to run (drop any you replace with an external server)
COMPOSE_PROFILES=mysql,redis

APP_NAME=Synchro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The public URL served by the host's nginx (it owns the domain and HTTPS)
APP_URL=https://synchro.example.com
# The host's nginx proxies to 127.0.0.1:${APP_PORT}
APP_PORT=8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Who the containers run as and where storage lives on the host (optional)
# APP_USER=1000:1000
# APP_STORAGE=/home/synchro/synchro-storage

LOG_CHANNEL=stderr
LOG_LEVEL=info

# MySQL 8.0 (the `mysql` profile)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=synchro
DB_USERNAME=synchro
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Redis (the `redis` profile): queues (Horizon), cache, and sessions
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=700
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Horizon emails this address when a queue waits too long (optional)
HORIZON_NOTIFY_EMAIL=

# Outgoing mail (invitation emails are sent by the Horizon workers)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@isga.ma"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
