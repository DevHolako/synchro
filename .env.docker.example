# Synchro production environment for Docker & Coolify (ADR 0012).
# Copy to `.env` next to docker-compose.yml or paste into Coolify Environment Variables.

# Bundled services to run (drop any you replace with an external server or Coolify managed database)
COMPOSE_PROFILES=mysql,redis

APP_NAME=Synchro
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# The public URL served by the reverse proxy (Coolify/Traefik/Nginx with HTTPS)
APP_URL=https://synchro.example.com
APP_PORT=8000

# Container role for single-container Coolify deployment (set to "all" to run Web + Horizon + Scheduler in 1 container)
# CONTAINER_ROLE=all

APP_LOCALE=fr
SCHEDULE_TIMEZONE=Africa/Casablanca
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Who the containers run as and host storage mapping (optional)
# APP_USER=1000:1000
# APP_STORAGE=/home/synchro/synchro-storage

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database connection (MySQL 8.0)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=synchro
DB_USERNAME=synchro
DB_PASSWORD=change-me-to-a-strong-password
DB_ROOT_PASSWORD=change-me-to-a-strong-root-password

# Redis: queues (Horizon), cache, and sessions
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=700
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Horizon alerts (optional)
HORIZON_NOTIFY_EMAIL=

# Outgoing mail (invitation emails, convocation notices)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@isga.ma"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Emergency alert gateway driver (Part 06): log, database, twilio, whatsapp
URGENT_MESSAGES_DRIVER=log

# Twilio SMS configuration (if URGENT_MESSAGES_DRIVER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp Cloud API configuration (if URGENT_MESSAGES_DRIVER=whatsapp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
