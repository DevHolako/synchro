{
	{$CADDY_GLOBAL_OPTIONS}
	frankenphp
	order php_server before file_server
}

{$SERVER_NAME:localhost} {
	root * /app/public
	encode zstd gzip

	# Spreadsheet imports accept up to 5 MB (ImportSpreadsheetRequest::MAX_KILOBYTES)
	request_body {
		max_size 12MB
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Vite assets are content-hashed, so they can be cached forever
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	@dotfiles {
		path */.*
		not path /.well-known/*
	}
	respond @dotfiles 404

	# Serve static files and fallback to Laravel index.php
	php_server {
		resolve_root_symlink
	}
}
